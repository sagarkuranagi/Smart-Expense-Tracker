PORT=5000
# Set a local or Atlas MongoDB connection string for persistent accounts and transactions.
MONGODB_URI=
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# In production, also set NODE_ENV=production to enable secure-only session cookies.
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
